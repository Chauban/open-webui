[Unit]
Description=RightWrite 每日备份（Postgres + 上传文件）
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=rightwrite
Group=rightwrite
ExecStart=/opt/rightwrite/backup.sh
SyslogIdentifier=rightwrite-backup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rightwrite
